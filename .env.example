# Copy this file to .env for local development (never commit real values)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GCS_BUCKET_NAME=
FIRESTORE_DATABASE=default
VERTEX_RAG_DATASTORE_ID=

# --- Optional Security Hardening, Auth & RBAC ---
# AUTH_MODE: none (default local demo) | iap (Google Cloud IAP) | login (signed session token)
AUTH_MODE=none
# Comma-separated emails granted Brand/Regulatory Admin role when RBAC is enforced
CHOPO_ADMIN_EMAILS=
# Defaults to true when AUTH_MODE != none, false when AUTH_MODE=none
# RBAC_ENFORCE=false
# Defaults to true when AUTH_MODE != none (scopes per-user runs in Firestore)
# USER_SCOPED_RUNS=false
# Optional: set to true only when testing IAP headers locally without JWT assertion
# IAP_ALLOW_HEADER_ONLY=false
# Required only when AUTH_MODE=login (use Secret Manager in Cloud Run)
# CHOPO_SESSION_SECRET=

# --- Optional Rate Limiting & Cloud Run Scaling ---
GENAI_RATE_LIMIT_MAX=60
GENAI_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=60000
MAX_INSTANCES=5
MIN_INSTANCES=0
CLOUD_RUN_TIMEOUT=300
